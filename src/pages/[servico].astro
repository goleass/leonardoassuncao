---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import "../styles/article.css";
import { site } from "../config/site";
import { services, type Service } from "../data/services";
import { loadGuides } from "../lib/guias/collection";
import { guidesFor, type Guide } from "../lib/guias/guias";
import { breadcrumbNode, faqNode, serviceNode } from "../lib/seo/schema";

// Uma página estática por serviço (SVC-01), com os guias do serviço (guias LINK-01).
export const getStaticPaths = (async () => {
  const guides = await loadGuides();
  return services.map((service) => ({
    params: { servico: service.slug },
    props: { service, guides: guidesFor(guides, service.slug) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
  guides: Guide[];
}

const { service, guides } = Astro.props;
const path = `/${service.slug}/`;
const others = services.filter((s) => s !== service);

const schema = [
  serviceNode(site, service),
  breadcrumbNode(site, [
    { name: "Início", path: "/" },
    { name: service.name, path },
  ]),
  faqNode(service.faq),
];
---

<BaseLayout site={site} title={service.title} description={service.description} schema={schema}>
  <Header slot="header" site={site} />

  <article class="svc">
    <header class="svc-hero surface-dark">
      <div class="container svc-hero__inner">
        <nav aria-label="Trilha de navegação">
          <ol class="crumbs">
            <li><a class="crumbs__link lg-ul" href="/">Início</a></li>
            <li aria-current="page">{service.name}</li>
          </ol>
        </nav>
        <h1 class="svc-hero__title">{service.h1}</h1>
        <p class="svc-hero__intro">{service.intro}</p>
        <div class="svc-hero__actions">
          <a class="button button--mark lg-btn lg-btn-m" href="#contato">Pedir orçamento</a>
          <a class="button button--outline lg-btn lg-btn-o" href={`https://wa.me/${site.whatsapp}`}>Chamar no WhatsApp</a>
        </div>
      </div>
    </header>

    <div class="container svc__body">
      {
        service.sections.map(({ title, paragraphs, items }) => (
          <section class="svc-section">
            <h2 class="svc-section__title">{title}</h2>
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {items && (
              <ul class="svc-section__list">
                {items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>

    <section class="svc-faq">
      <div class="container svc-faq__inner">
        <h2 class="svc-faq__title">Perguntas frequentes</h2>
        <div class="svc-faq__list">
          {
            service.faq.map(({ q, a }, index) => (
              <details class="svc-faq__item" open={index === 0}>
                <summary class="svc-faq__question">{q}</summary>
                <p class="svc-faq__answer">{a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </article>

  {
    guides.length > 0 && (
      <nav class="svc-others" aria-label={`Guias sobre ${service.name}`}>
        <div class="container">
          <h2 class="svc-others__title">Guias sobre {service.name}</h2>
          <ul class="svc-others__list">
            {guides.map((guide) => (
              <li>
                <a class="svc-others__link lg-ul" href={`/guias/${guide.slug}/`}>
                  {guide.h1}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }

  <nav class="svc-others" aria-label="Outros serviços">
    <div class="container">
      <h2 class="svc-others__title">Outros serviços</h2>
      <ul class="svc-others__list">
        {
          others.map((other) => (
            <li>
              <a class="svc-others__link lg-ul" href={`/${other.slug}/`}>
                {other.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <Contact site={site} />
  <Footer slot="footer" site={site} />
</BaseLayout>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 18px 26px;
    text-decoration: none;
    font-weight: 600;
  }

  .button--mark {
    background-color: var(--mark);
    color: var(--deep);
  }

  .button--outline {
    padding-inline: 24px;
    border: 1px solid var(--on-dark-line-strong);
    color: var(--on-dark);
    font-weight: 500;
  }
</style>
