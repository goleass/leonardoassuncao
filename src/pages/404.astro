---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
---

<BaseLayout
  site={site}
  title="Página não encontrada — Leonardo Gomes Assunção"
  description="O endereço acessado não existe. Volte para a página inicial para conhecer os serviços."
  noindex
>
  <Header slot="header" site={site} />
  <section class="not-found surface-dark">
    <div class="container not-found__inner">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1 class="not-found__title">Página não encontrada</h1>
      <p class="not-found__text">O endereço que você acessou não existe ou mudou de lugar.</p>
      <a class="not-found__link lg-btn lg-btn-m" href="/">Voltar para a página inicial</a>
    </div>
  </section>
  <Footer slot="footer" site={site} />
</BaseLayout>

<style>
  .not-found {
    padding: var(--section-y) var(--gutter);
    border-bottom: 1px solid var(--on-dark-line-soft);
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .not-found__code {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--on-dark-subtle);
  }

  .not-found__title {
    font-size: var(--text-h2);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    font-weight: 700;
    font-stretch: var(--stretch-display);
  }

  .not-found__text {
    max-width: 520px;
    font-size: var(--text-body-lg);
    color: var(--on-dark-muted);
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 16px;
    padding: 18px 26px;
    background-color: var(--mark);
    color: var(--deep);
    text-decoration: none;
    font-weight: 600;
  }
</style>
