---
import type { SiteConfig } from "../config/schema";
import { services } from "../data/services";
import Logo from "./Logo.astro";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer surface-dark">
  <div class="container site-footer__inner">
    <span class="site-footer__brand">
      <Logo class="site-footer__mark" />
      Leonardo Gomes Assunção
    </span>
    <nav class="site-footer__nav" aria-label="Serviços">
      <ul class="site-footer__list">
        {
          services.map(({ slug, name }) => (
            <li>
              <a class="site-footer__link lg-ul" href={`/${slug}/`}>
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <span>CNPJ {site.cnpj} · {site.cidade} · Atendimento em todo o Brasil</span>
    <span class="site-footer__end">
      <a class="site-footer__link lg-ul" href="/privacidade/">Política de privacidade</a>
      <span>© {year}</span>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    padding: 48px var(--gutter);
    color: var(--on-dark-muted);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px 40px;
    font-size: var(--text-small);
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--on-dark);
    font-weight: 700;
    font-stretch: var(--stretch-title);
    font-size: var(--text-body-sm);
  }

  .site-footer__brand :global(.site-footer__mark) {
    height: 20px;
  }

  .site-footer__nav {
    flex-basis: 100%;
  }

  .site-footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--on-dark);
    text-decoration: none;
  }
</style>
